# Example only. bun run env:setup generates a random local password.
POSTGRES_DB=lost_found
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/lost_found
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Lost & Found"
PORT=3000
LOG_LEVEL=info
DB_POOL_MAX=10
DB_SSL=disable
SESSION_COOKIE_NAME=lost_found_session
SESSION_TTL_DAYS=7
