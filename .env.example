# Example only. bun run env:setup generates a random local password.
POSTGRES_DB=lost_found
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/lost_found
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Lost & Found"
PORT=3000
LOG_LEVEL=info
DB_POOL_MAX=10
DB_SSL=disable
SESSION_COOKIE_NAME=lost_found_session
SESSION_TTL_DAYS=7

# Optional Microsoft Entra ID sign-in. Set all three privately. See docs/MICROSOFT_SSO.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Optional Entra directory extension claim, e.g. extn.studentId.
MICROSOFT_STUDENT_ID_CLAIM=
# Local development only. Logs verified ID token claim names and types.
MICROSOFT_DEBUG_CLAIMS=false

# External item matching (server-only). Off until a key and explicit lifetime USD budget are set.
MATCHING_ENABLED=false
MATCHING_PROVIDER=openai
MATCHING_BUDGET_USD=0
# OPENAI_API_KEY= (set privately; never use NEXT_PUBLIC_ or commit a real key)
# Cloudflare Workers Free requires MATCHING_PROVIDER=cloudflare and a zero USD budget.
MATCHING_FREE_DAILY_LIMIT=10
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WORKERS_AI_TOKEN=
# MATCHING_RUNNER_SECRET= (64 random lowercase hex digits, for the serverless scheduler only)
