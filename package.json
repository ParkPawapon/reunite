{
  "name": "campus-lost-found",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "design:tokens": "node scripts/design-tokens.mjs",
    "design:tokens:check": "node scripts/design-tokens.mjs --check",
    "design:mascot": "node scripts/generate-mascot.mjs",
    "design:mascot:check": "node scripts/generate-mascot.mjs --check",
    "dev": "bun run --filter @campus/web dev",
    "build": "bun run --filter @campus/web build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter @campus/web typecheck",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --conditions=react-server --import tsx packages/database/scripts/migrate.ts",
    "db:migrate:status": "node --env-file-if-exists=.env --conditions=react-server --import tsx packages/database/scripts/migration-status.ts",
    "db:create-user": "node --env-file-if-exists=.env --conditions=react-server --import tsx packages/database/scripts/create-user.ts",
    "db:seed": "node --env-file-if-exists=.env --conditions=react-server --import tsx packages/database/scripts/seed.ts",
    "db:cleanup-auth": "node --env-file-if-exists=.env --conditions=react-server --import tsx packages/database/scripts/cleanup-auth.ts",
    "env:setup": "node scripts/setup-env.mjs",
    "env:check": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/check-env.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@campus/database": "workspace:*",
    "@campus/shared": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
