# bun run env:setup creates this file with the same generated local credentials as root .env.
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/lost_found
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Lost & Found"
LOG_LEVEL=info
DB_POOL_MAX=10
DB_SSL=disable
SESSION_COOKIE_NAME=lost_found_session
SESSION_TTL_DAYS=7

# Optional Microsoft Entra ID sign-in. Set all three privately. See docs/MICROSOFT_SSO.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Optional Entra directory extension claim, e.g. extn.studentId.
MICROSOFT_STUDENT_ID_CLAIM=

# External item matching; see docs/MATCHING.md before enabling paid processing.
MATCHING_ENABLED=false
MATCHING_PROVIDER=openai
MATCHING_BUDGET_USD=0
# OPENAI_API_KEY= (server-only; set privately)
MATCHING_FREE_DAILY_LIMIT=10
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_WORKERS_AI_TOKEN= (server-only; set privately)
