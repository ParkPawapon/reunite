# bun run env:setup creates this file with the same generated local credentials as root .env.
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/lost_found
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Lost & Found"
LOG_LEVEL=info
DB_POOL_MAX=10
DB_SSL=disable
SESSION_COOKIE_NAME=lost_found_session
SESSION_TTL_DAYS=7
